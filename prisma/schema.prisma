generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id             String       @id @default(cuid())
  name           String       @unique
  nineHolePar    Int
  nineHoleRating Float
  nineHoleSlope  Int
  tees           CourseTee[]
  holes          CourseHole[]
  weeks          Week[]
  createdAt      DateTime     @default(now())
}

model CourseTee {
  id             String   @id @default(cuid())
  courseId       String
  color          TeeColor
  gender         Gender   @default(man)
  nineHolePar    Int
  nineHoleRating Float
  nineHoleSlope  Int
  course         Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, color, gender])
}

enum TeeColor {
  blue
  silver
  white
  yellow
}

enum Gender {
  man
  woman
}

model CourseHole {
  id               String @id @default(cuid())
  courseId         String
  holeNumber       Int
  par              Int
  strokeIndex      Int
  womenStrokeIndex Int
  course           Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, holeNumber])
}

model Player {
  id              String           @id @default(cuid())
  name            String
  gender          Gender           @default(man)
  defaultTeeColor TeeColor?
  email           String?
  cellPhone       String?
  active          Boolean          @default(true)
  seedHandicap    Float?
  seasonTeeChoices PlayerSeasonTee[]
  attendance      Attendance[]
  handicapRecords HandicapRecord[]
  matchesAsP1     Match[]          @relation("Player1Matches")
  matchesAsP2     Match[]          @relation("Player2Matches")
  weeksCtp        Week[]           @relation("CtpWinner")
  weeksLp         Week[]           @relation("LpWinner")
  weeksCommissioner Week[]         @relation("WeekCommissioner")
  holeScores      HoleScore[]
  auditLogs       AuditLog[]
  createdAt       DateTime         @default(now())
}

model Season {
  id        String     @id @default(cuid())
  name      String
  type      SeasonType
  startDate DateTime
  endDate   DateTime
  archivedAt DateTime?
  playerTeeChoices PlayerSeasonTee[]
  weeks     Week[]
  createdAt DateTime   @default(now())
}

model PlayerSeasonTee {
  id        String   @id @default(cuid())
  playerId  String
  seasonId  String
  teeColor  TeeColor @default(white)
  createdAt DateTime @default(now())
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  season    Season   @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([playerId, seasonId])
}

enum SeasonType {
  spring
  summer
}

enum HandicapMode {
  index
  course
}

model Week {
  id                    String           @id @default(cuid())
  seasonId              String
  weekNumber            Int
  date                  DateTime
  startedAt             DateTime?
  completedAt           DateTime?
  handicapMode          HandicapMode     @default(index)
  courseId              String?
  ctpHoleNumber         Int?
  longestPuttHoleNumber Int?
  ctpWinnerId           String?
  longestPuttWinnerId   String?
  commissionerPlayerId  String?
  locked                Boolean          @default(false)
  season                Season           @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  course                Course?          @relation(fields: [courseId], references: [id])
  ctpWinner             Player?          @relation("CtpWinner", fields: [ctpWinnerId], references: [id])
  longestPuttWinner     Player?          @relation("LpWinner", fields: [longestPuttWinnerId], references: [id])
  commissionerPlayer    Player?          @relation("WeekCommissioner", fields: [commissionerPlayerId], references: [id], onDelete: SetNull)
  attendance            Attendance[]
  matches               Match[]
  handicapRecords       HandicapRecord[]
  holeScores            HoleScore[]
  auditLogs             AuditLog[]
  createdAt             DateTime         @default(now())

  @@unique([seasonId, weekNumber])
  @@unique([seasonId, date])
}

model Attendance {
  id                  String    @id @default(cuid())
  weekId              String
  playerId            String
  present             Boolean   @default(false)
  ctpPoolPaid         Boolean   @default(false)
  longestPuttPoolPaid Boolean   @default(false)
  checkedInAt         DateTime?
  week                Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  player              Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([weekId, playerId])
}

model Match {
  id                      String      @id @default(cuid())
  weekId                   String
  player1Id                String
  player2Id                String
  player1TeeOverrideColor  TeeColor?
  player2TeeOverrideColor  TeeColor?
  player1HandicapIndex     Float?
  player2HandicapIndex     Float?
  player1PlayingHandicap   Int?
  player2PlayingHandicap   Int?
  strokeWinnerId           String?
  matchPlayLeadBy          Int?
  matchPlayHolesRemaining  Int?
  matchPlayWinnerId        String?
  player2ScorecardOnly     Boolean     @default(false)
  locked                   Boolean     @default(false)
  week                     Week        @relation(fields: [weekId], references: [id], onDelete: Cascade)
  player1                  Player      @relation("Player1Matches", fields: [player1Id], references: [id], onDelete: Restrict)
  player2                  Player      @relation("Player2Matches", fields: [player2Id], references: [id], onDelete: Restrict)
  holeScores               HoleScore[]
  auditLogs                AuditLog[]
  createdAt                DateTime    @default(now())
}

model HoleScore {
  id            String    @id @default(cuid())
  weekId         String
  playerId       String
  matchId        String?
  holeNumber     Int
  grossScore     Int
  adjustedScore  Int
  week           Week      @relation(fields: [weekId], references: [id], onDelete: Cascade)
  player         Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match          Match?    @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@unique([weekId, playerId, holeNumber])
}

model HandicapRecord {
  id                 String    @id @default(cuid())
  playerId           String
  weekId             String?
  date               DateTime
  grossScore         Int
  adjustedGrossScore Int
  courseRating       Float
  slopeRating        Int
  coursePar          Int
  courseDifferential Float
  usedInIndex        Boolean   @default(false)
  isImported         Boolean   @default(false)
  countsForHandicap  Boolean   @default(true)
  week               Week?     @relation(fields: [weekId], references: [id], onDelete: SetNull)
  player             Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  createdAt          DateTime  @default(now())

  @@unique([playerId, date, grossScore])
  @@unique([playerId, weekId])
}

model AuditLog {
  id        String   @id @default(cuid())
  weekId    String?
  matchId   String?
  playerId  String?
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  timestamp DateTime @default(now())
  week      Week?    @relation(fields: [weekId], references: [id], onDelete: SetNull)
  match     Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  player    Player?  @relation(fields: [playerId], references: [id], onDelete: SetNull)
}

model Commissioner {
  id                 String   @id @default(cuid())
  username           String   @unique
  passwordHash       String
  publicRosterEnabled Boolean @default(false)
  createdAt          DateTime @default(now())
}
